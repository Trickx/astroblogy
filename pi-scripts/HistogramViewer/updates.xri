<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>
         HistogramViewer PixInsight Module Updates
      </p>
   </description>
   <platform os="macosx" arch="arm64" version="1.9.5:1.9.99">
      <package fileName="HistogramViewer20260925v0100-macosx-arm64.tar.gz" sha1="f1682e0cdd73d1f837ffe42cfcc74dd858314f82" type="module" releaseDate="20260925">
         <title>
         HistogramViewer 1.0.0
         </title>
         <description>
            <p>
               Installs the HistogramViewer PixInsight module: a non-destructive histogram and
               statistics viewer with separate RGB curves, logarithmic axes, zoom and range
               controls, percentiles and clipping statistics.
            </p>
            <p>
               Installed files:
               <br/>bin/HistogramViewer-pxm.dylib
               <br/>bin/HistogramViewer-pxm.xsgn
            </p>
            <p>
               Port of the histogram view from Seti Astro Suite Pro (SASpro) by Franklin Marek.
               Released under the GNU General Public License v3. Source code:
               https://github.com/Trickx/PI-Histogram (commit db83ebd).
            </p>
            <p>
               This product is based on software from the PixInsight project, developed by
               Pleiades Astrophoto and its contributors (https://pixinsight.com/).
            </p>
         </description>
      </package>
   </platform>
