   <platform os="all" arch="noarch" version="1.9.4:1.9.99">
      <package fileName="CanonBandingReduction20261011v0102.tar.gz" sha1="7b0e7f24829cae368f29bcaf13221add2e380449" type="script" releaseDate="20261011">
         <title>
         CanonBandingReduction 0.10.2
         </title>
         <remove>
            src/scripts/CanonBandingReduction/CanonBandingReduction.js
            src/scripts/CanonBandingReduction/CanonBandingReduction.svg
            src/scripts/CanonBandingReduction/CanonBandingReduction.xsgn
            src/scripts/Trickx/CanonBandingReduction/CanonBandingReduction.js
            src/scripts/Trickx/CanonBandingReduction/CanonBandingReduction.svg
            src/scripts/Trickx/CanonBandingReduction/CanonBandingReduction.xsgn
            src/scripts/CanonBandingReduction/
            src/scripts/Trickx/CanonBandingReduction/
         </remove>
         <description>
            <p>
               Installs the CanonBandingReduction PixInsight feature script, which reduces the horizontal banding of Canon DSLR images with live preview and highlight protection.
            </p>
            <p>
               Changes in 0.10.2: applied settings are stored in the processing history of the image, and name, version, time and settings are recorded in the XISF property Processing:History and in FITS HISTORY keywords. Apply now closes the dialog with a single click.
            </p>
            <p>
               Installed files:
               <br/>src/scripts/Tricx/CanonBandingReduction/CanonBandingReduction.js
               <br/>src/scripts/Tricx/CanonBandingReduction/CanonBandingReduction.svg
               <br/>src/scripts/Tricx/CanonBandingReduction/CanonBandingReduction.xsgn
            </p>
         </description>
      </package>
   </platform>
</xri>
