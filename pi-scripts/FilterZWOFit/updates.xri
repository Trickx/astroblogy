         <title>
         FilterZWOFit 1.0.19
         </title>
         <remove>
            src/scripts/FilterZWOFit/FilterZWOFit.js
            src/scripts/FilterZWOFit/FilterZWOFit.svg
            src/scripts/FilterZWOFit/FilterZWOFit.xsgn
