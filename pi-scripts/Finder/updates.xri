<xri version="1.0">
   <description>
      <p>
         Finder PixInsight Module Updates
      </p>
   </description>
   <platform os="macosx" arch="arm64" version="1.9.5:1.9.99">
      <package fileName="Finder20261002v0100-macosx-arm64.tar.gz" sha1="bf2b67c141109db1b36e4f7d94a68948e35d45d5" type="module" releaseDate="20261002">
         <title>
         Finder 1.0.0
         </title>
         <description>
            <p>
               Installs the Finder PixInsight module: a compact search window that finds
               installed processes and PJSR scripts by name while typing and launches the
               selected one with Return or a double click.
            </p>
            <p>
               Installed files:
               <br/>bin/Finder-pxm.dylib
               <br/>bin/Finder-pxm.xsgn
            </p>
            <p>
               Released under the GNU General Public License v3. Source code:
               https://github.com/Trickx/PI-Finder (commit 0b7d30d).
            </p>
            <p>
               This product is based on software from the PixInsight project, developed by
               Pleiades Astrophoto and its contributors (https://pixinsight.com/).
            </p>
         </description>
      </package>
   </platform>
